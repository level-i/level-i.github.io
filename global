<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Level-i | Global Command & Private Mandates</title>
    <!-- Leaflet CSS per al mapa interactiu -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
    <style>
        :root {
            --bg-base: #090d16;
            --bg-panel: #111827;
            --bg-card: rgba(17, 24, 39, 0.85);
            --accent-green: #10b981;
            --accent-blue: #3b82f6;
            --accent-gold: #C5A059;
            --text-main: #f9fafb;
            --text-muted: #9ca3af;
            --border-color: #374151;
        }

        html, body { margin: 0; padding: 0; height: 100%; width: 100%; background: var(--bg-base); color: var(--text-main); font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; overflow: hidden; }

        /* Contenidor Principal del Mapa a Pantalla Completa */
        #map { width: 100%; height: 100vh; z-index: 1; background: var(--bg-base); }

        /* Header flotant tipus HUD */
        .command-header {
            position: absolute;
            top: 20px;
            left: 20px;
            right: 20px;
            z-index: 1000;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: var(--bg-card);
            backdrop-filter: blur(10px);
            border: 1px solid var(--border-color);
            padding: 12px 20px;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        }
        .command-brand { display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: 16px; color: #fff; }
        .brand-dot { width: 10px; height: 10px; background-color: var(--accent-green); border-radius: 50%; box-shadow: 0 0 10px var(--accent-green); }
        .command-badge { font-size: 11px; background: rgba(197, 160, 89, 0.15); color: var(--accent-gold); border: 1px solid var(--accent-gold); padding: 4px 10px; border-radius: 6px; font-weight: bold; letter-spacing: 1px; }

        /* Galàxia Tecnològica (Menú Inferior Flotant) */
        .tech-galaxy-dock {
            position: absolute;
            bottom: 25px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 1000;
            display: flex;
            gap: 12px;
            background: var(--bg-card);
            backdrop-filter: blur(12px);
            border: 1px solid var(--border-color);
            padding: 10px 18px;
            border-radius: 40px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.7);
        }
        .dock-item {
            background: transparent;
            border: 1px solid transparent;
            color: var(--text-muted);
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 12.5px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
            white-space: nowrap;
        }
        .dock-item:hover { background: rgba(255,255,255,0.05); color: #fff; border-color: var(--border-color); }
        .dock-item.active { background: linear-gradient(135deg, rgba(197, 160, 89, 0.2), rgba(16, 185, 129, 0.2)); color: var(--accent-gold); border-color: var(--accent-gold); box-shadow: 0 0 15px rgba(197, 160, 89, 0.2); }

        /* Estils personalitzats per als Popups del Mapa (Targetes VIP) */
        .leaflet-popup-content-wrapper {
            background: var(--bg-panel) !important;
            color: var(--text-main) !important;
            border: 1px solid var(--accent-gold);
            border-radius: 12px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.6);
        }
        .leaflet-popup-tip { background: var(--bg-panel) !important; }
        .popup-title { font-size: 15px; font-weight: bold; color: #fff; margin-bottom: 5px; }
        .popup-desc { font-size: 12px; color: var(--text-muted); margin-bottom: 10px; line-height: 1.4; }
        .popup-price { font-size: 16px; font-weight: bold; color: var(--accent-gold); margin-bottom: 12px; }
        .popup-btn {
            display: block;
            width: 100%;
            background: var(--accent-green);
            color: #fff;
            text-align: center;
            padding: 8px;
            border-radius: 6px;
            font-size: 12px;
            font-weight: bold;
            text-decoration: none;
            cursor: pointer;
            border: none;
            box-shadow: 0 4px 10px rgba(16, 185, 129, 0.3);
            transition: opacity 0.2s;
        }
        .popup-btn:hover { opacity: 0.9; }

        /* Adaptació a mòbils */
        @media (max-width: 768px) {
            .command-header { top: 10px; left: 10px; right: 10px; padding: 10px 14px; }
            .command-badge { display: none; }
            .tech-galaxy-dock { bottom: 15px; width: 90%; justify-content: space-around; padding: 8px 10px; }
            .dock-item { padding: 6px 10px; font-size: 11px; }
        }
    </style>
</head>
<body>

    <!-- Header HUD Global Command -->
    <div class="command-header">
        <div class="command-brand">
            <span class="brand-dot"></span> Level-i | Global Command
        </div>
        <div class="command-badge">EXCLUSIVAS VIP GIS</div>
    </div>

    <!-- Mapa Interactiu a Pantalla Completa -->
    <div id="map"></div>

    <!-- Galàxia Tecnològica (Barra de Navegació Inferior) -->
    <div class="tech-galaxy-dock">
        <a href="#" class="dock-item active">🗺️ Mapa Exclusivas</a>
        <a href="/" class="dock-item">🎯 Sòl Alcanar</a>
        <a href="#" onclick="alert('Módulo de Mandatos VIP próximamente')" class="dock-item">🔐 Mandatos VIP</a>
    </div>

    <!-- Leaflet JS per al mapa -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script>
        // Inicialitzar el mapa centrat a Espanya (amb zoom adaptat)
        const map = L.map('map', { zoomControl: false }).setView([40.5, -0.5], 7);

        // Afegir capa de mapa fosc elegant (CartoDB Dark Matter)
        L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
            subdomains: 'abcd',
            maxZoom: 19
        }).addTo(map);

        // Afegir control de zoom a la dreta
        L.control.zoom({ position: 'topright' }).addTo(map);

        // Base de dades de les propietats en exclusiva (Alcanar i Barcelona per començar)
        const propietatsExclusives = [
            {
                id: "alcanar-1",
                titulo: "Suelo Residencial - Les Cases d'Alcanar",
                descripcion: "Parcela urbana consolidada (Clau 17a1), a 300m del mar. 460 m² netos.",
                precio: "160.000 €",
                lat: 40.5532, 
                lng: 0.5312  // Coordenada aproximada de referència per a Les Cases
            },
            {
                id: "barcelona-1",
                titulo: "Átic Exclusivo - Barcelona",
                descripcion: "Diseño vanguardista, vistas panorámicas sobre la ciudad y acabados de lujo.",
                precio: "En exclusiva (Consultar)",
                lat: 41.3851,
                lng: 2.1734   // Coordenada de Barcelona
            }
        ];

        // Afegir els marcadors al mapa amb les targetes informatives
        propietatsExclusives.forEach(prop => {
            const marker = L.marker([prop.lat, prop.lng]).addTo(map);

            const popupContent = `
                <div class="popup-title">${prop.titulo}</div>
                <div class="popup-desc">${prop.descripcion}</div>
                <div class="popup-price">${prop.precio}</div>
                <button class="popup-btn" onclick="consultarElena('${prop.titulo}', '${prop.precio}')">💬 Consultar con Elena</button>
            `;

            marker.bindPopup(popupContent);
        });

        // Funció per connectar amb el bot/assistent quan el client mostra interès
        function consultarElena(titulo, precio) {
            alert(`Conectando con Elena (AI Advisor) para la propiedad: ${titulo} (${precio}). Aquí se activará el flujo de atención VIP.`);
            // Opcionalment pots redirigir o obrir el xat de la consola
        }
    </script>
</body>
</html>
